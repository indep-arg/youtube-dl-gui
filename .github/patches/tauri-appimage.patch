+  ///
+  /// When set, the generated AppImage and its .zsync file must not be renamed
+  /// to keep the update mechanism working.
+  ///
+  /// Only used by the new AppImage format, see `use_new_format`.
+  pub update_information: Option<String>,
 }
 
