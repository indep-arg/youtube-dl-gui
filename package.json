{
  "name": "open-video-downloader",
  "version": "2026.10.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indep-arg/youtube-dl-gui.git"
  },
  "scripts": {
    "dev": "cross-env DEV=true vite",
    "build": "npm run build:app && npm run build:isolation",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:isolation": "vue-tsc --noEmit && vite build --config vite.config.isolation.ts",
    "tauri": "tauri",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "rust:clippy": "cargo clippy --manifest-path=src-tauri/Cargo.toml --all-features --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path=src-tauri/Cargo.toml --all",
    "rust:lint": "npm run rust:fmt && npm run rust:clippy",
    "rust:test": "cargo test --manifest-path=src-tauri/Cargo.toml --all-features --all-targets",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "version:check": "node scripts/check-version.ts",
    "manifest:gen": "node scripts/gen-manifest.ts",
    "manifest:sign": "node scripts/sign-manifest.ts",
    "manifest:verify": "node scripts/verify-manifest.ts",
    "licenses:npm": "license-checker-rseidelsohn --production --json --out licenses/licenses-npm.json",
    "licenses:rust": "cargo about generate --manifest-path=src-tauri/Cargo.toml --output-file licenses/licenses-rust.txt src-tauri/about.hbs",
    "licenses:gen": "node scripts/licenses.ts",
    "licenses": "npm run licenses:npm && npm run licenses:rust && npm run licenses:gen"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "iso-639-1": "^3.1.5",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.1",
    "uuid": "^14.0.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "daisyui": "^5.6.3",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "monocart-coverage-reports": "^2.12.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.1"
  },
  "overrides": {
    "vite-plugin-vue-devtools": {
      "vite-plugin-inspect": "^11.3.3"
    }
  }
}
